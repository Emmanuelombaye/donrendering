{
    "version": 2,
    "builds": [
        {
            "src": "api/index.py",
            "use": "@vercel/python"
        },
        {
            "src": "visoid-frontend/package.json",
            "use": "@vercel/static-build",
            "config": {
                "distDir": "build"
            }
        }
    ],
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": "api/index.py"
        },
        {
            "source": "/outputs/(.*)",
            "destination": "/api/outputs/$1"
        },
        {
            "source": "/(.*)",
            "destination": "visoid-frontend/$1"
        }
    ]
}